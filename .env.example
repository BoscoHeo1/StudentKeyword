# Server Environment Variables
PORT=3000

# [RECOMMENDED] Gemini API Key (Server-side)
GEMINI_API_KEY=

# [OPTIONAL] PostgreSQL Connection String for Cloud Databases (Supabase or Neon)
# If provided, the app will automatically switch to using this cloud database instead of local JSON file.
# Format: postgres://username:password@hostname:port/database_name?sslmode=require
DATABASE_URL=

# [OPTIONAL] Firebase Firestore Configuration for Cloud Databases
# If provided, the app will automatically switch to using Firebase Firestore instead of PostgreSQL or local JSON file.
# You can find these values in your Firebase Console under Project Settings.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
